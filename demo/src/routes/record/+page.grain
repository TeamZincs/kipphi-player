<script>
    import {
        downloadResult,
        getSession,
        type DemoSession,
        type PreparedPack,
    } from "../../session";
    import type { RendererPreference } from "../..";

    let session: DemoSession | null = null;
    /** 只解了包、还没建播放器（点按钮时才知道要哪个后端） */
    let prepared: PreparedPack | null = null;
    /** 这一页不展示画面：播放器画在一块藏起来的 canvas 上 */
    let canvasEl: HTMLCanvasElement | null = null;
    /** 站内链接按 base 拼（多页模式下地址带目录） */
    const homeHref = import.meta.env.BASE_URL;

    let ready = $state(false);
    let hasPack = $state(false);
    let busy = $state(false);
    let status = $state("正在准备资源…");
    let full = $state(true);
    /** 秒；结束留空表示到曲末 */
    let startAt = $state("0");
    let endAt = $state("");

    let logs: string[] = $state([]);
    let progress = $state(0);
    let frames = $state(0);
    let totalFrames = $state(0);
    let speed = $state(0);
    let elapsed = $state(0);

    let startedAt = 0;

    /** 拿 [起, 止) 的秒数区间；止为 null 表示到曲末 */
    function recordRange(duration: number): [number, number | null] | null {
        const from = Number(startAt);

        const to = endAt === "" ? null : Number(endAt);

        if (!(from >= 0) || !(to > from) || !(from < duration)) {
            return null;
        }

        return [from, to];
    }

    function log(message: string) {
        const now = new Date();
        const stamp = [now.getHours(), now.getMinutes(), now.getSeconds()]
            .map(part => String(part).padStart(2, "0"))
            .join(":");

        logs.push(`${stamp}  ${message}`);

        // 别让日志无限长
        if (logs.length > 200) {
            logs.splice(0, logs.length - 200);
        }
    }

    getSession().then(created => {
        session = created;
        ready = true;
        status = "选一个谱面压缩包";
        log("资源就绪（图片 / 字体 / 资源包 / 打击音）");
    }).catch(error => {
        console.error(error);
        status = `初始化失败：${(error as Error).message}`;
        log(`初始化失败：${(error as Error).message}`);
    });

    async function pick(event: Event) {
        const input = event.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file || !session || !canvasEl) {
            return;
        }

        busy = true;
        status = "正在解压…";
        log(`载入 ${file.name}`);
        try {
            // 只解包、不建播放器：这个页面是用来录制的，用户点了按钮才知道要哪个后端
            //
            // sequential：视频走直通（不重编码），省掉一整轮转码和编码器占用
            prepared = await session.load(file, log, { sequential: true });
            hasPack = true;
            status = "选个时长，然后录";
            log(`谱面就绪：${prepared.duration.toFixed(1)}s（点按钮时再建播放器）`);
        } catch (error) {
            console.error(error);
            status = `加载失败：${(error as Error).message}`;
            log(`加载失败：${(error as Error).message}`);
        } finally {
            busy = false;
        }
    }

    /**
     * 录制进度
     *
     * 保持**顶层具名函数**：它由 recorder 从另一个模块回调，写在 `record()` 内部的话
     * 就归 `record` 那一次守卫管，得等 `record` 走到自己的 await / 返回才刷。
     */
    function onRecordProgress(frame: number, total: number) {
        frames = frame;
        totalFrames = total;
        progress = total > 0 ? frame / total : 0;

        const seconds = (performance.now() - startedAt) / 1000;

        elapsed = seconds;
        speed = seconds > 0 ? frame / seconds : 0;
        status = `录制中 ${(progress * 100).toFixed(1)}%`;

        if (frame === total || frame % 300 === 0) {
            log(`${(progress * 100).toFixed(0)}%  ${frame}/${total} 帧  ${speed.toFixed(1)} fps`);
        }
    }

    async function record(target: "canvas" | "offscreen", renderer?: RendererPreference) {
        const current = prepared;
        if (!current || !session || !canvasEl || busy) {
            return;
        }

        const range = full ? [0, null] : recordRange(current.duration);

        if (range === null) {
            status = "时间范围不对（要 0 ≤ 起 < 止，且起 < 曲长）";
            return;
        }

        busy = true;
        progress = 0;
        frames = 0;
        totalFrames = 0;
        speed = 0;
        elapsed = 0;
        status = "准备中…";
        startedAt = performance.now();
        log(`开始录制（${target}${renderer ? ` / ${renderer}` : ""}）`);

        try {
            const result = await session.record(current, target, range, onRecordProgress, renderer);

            const seconds = ((performance.now() - startedAt) / 1000).toFixed(1);
            const megabytes = (result.blob.size / 1024 / 1024).toFixed(1);
            status = `${result.container.toUpperCase()} / ${result.videoCodec}`
                + `${result.audioCodec ? " + " + result.audioCodec : "（无音频）"}`
                + `，${megabytes} MB，耗时 ${seconds}s`;
            log(`完成：${status}`);
            downloadResult(result, `kipphi-${target}`);
        } catch (error) {
            console.error(error);
            status = `录制失败：${(error as Error).message}`;
            log(`录制失败：${(error as Error).message}`);
        } finally {
            busy = false;
        }
    }
</script>

<section class="bar">
    <a href={homeHref} style="color: #66ccff">播放器</a>
</section>

<main class="panel">
    <p class="headline">{status}</p>

    <p class="hint">带特效的谱请用「强制 WebGL 1」——特效只在 WebGL 1 后端跑，WebGPU 那套还没跟上。</p>
    {#if ready}
    <input type="file" accept=".zip,.pez" onchange={pick} disabled={busy} />
    {/if}

    {#if hasPack}
    <input type="checkbox" bind:checked={full}>

    {#if !full}
    <div>
    
    <label>
        起
        <input class="num" type="number" min="0" step="0.1" bind:value={startAt} disabled={busy} />
    </label>

    <label>
        止
        <input class="num" type="number" min="0" step="0.1" placeholder="留空 = 曲末" bind:value={endAt} disabled={busy} />
    </label>
    </div>
    {/if}
    <div>
    <button onclick={() => void record("canvas")} disabled={!hasPack || busy}>录制（可见画布）</button>
    <button onclick={() => void record("offscreen")} disabled={!hasPack || busy}>后台录制</button>
    <button onclick={() => void record("offscreen", "webgl1")} disabled={!hasPack || busy}>后台录制（强制 WebGL 1）</button>
    </div>

    

    <div class="progress"><div class="fill" style="width: {(progress * 100).toFixed(1)}%"></div></div>

    <dl class="stats">
        <div><dt>帧</dt><dd>{frames} / {totalFrames}</dd></div>
        <div><dt>速度</dt><dd>{speed.toFixed(1)} fps</dd></div>
        <div><dt>已用</dt><dd>{elapsed.toFixed(1)} s</dd></div>
    </dl>
    
    {/if}

    {#if logs.length > 0}
        <ol class="logs">
            {#for line of logs}
                <li>{line}</li>
            {/for}
        </ol>
    {/if}
</main>

<script onmount>
    // 画面藏到视口外：WebGL 照样渲染，只是用户看不见
    const canvas = document.createElement("canvas");

    canvas.width = 1600;
    canvas.height = 900;
    canvas.style.position = "fixed";
    canvas.style.left = "-10000px";
    document.body.appendChild(canvas);
    canvasEl = canvas;
</script>

<style>
    .bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: 0.5rem 0.75rem;
    }

    .bar button {
        padding: 0.25rem 0.6rem;
    }

    .panel {
        margin: 0 auto;
        max-width: 46rem;
        padding: 0 1rem 2rem;
        font: 13px/1.6 system-ui, sans-serif;
    }

    .headline {
        font-size: 1.05rem;
        margin: 1rem 0 0.75rem;
    }

    .progress {
        background: #222;
        border-radius: 999px;
        height: 8px;
        overflow: hidden;
    }

    .fill {
        background: #4c8;
        height: 100%;
    }

    .stats {
        display: flex;
        gap: 2rem;
        margin: 0.75rem 0 1.25rem;
    }

    .stats div {
        display: flex;
        flex-direction: column;
    }

    .stats dt {
        color: #789;
        font-size: 0.8rem;
    }

    .stats dd {
        font-variant-numeric: tabular-nums;
        margin: 0;
    }

    .num {
        width: 5rem;
    }

    .hint {
        color: #a86;
        font-size: 0.85rem;
        margin: 0 0 1rem;
    }

    .logs {
        background: #161616;
        border-radius: 6px;
        color: #9ab;
        font-family: ui-monospace, monospace;
        font-size: 12px;
        line-height: 1.7;
        list-style: none;
        margin: 0;
        max-height: 18rem;
        overflow: auto;
        padding: 0.6rem 0.9rem;
    }
</style>
