<script>
    import { getSession, type DemoSession, type LoadedPack } from "../session";

    let session: DemoSession | null = null;
    let pack: LoadedPack | null = null;
    let canvasEl: HTMLCanvasElement | null = null;

    let ready = $state(false);
    let hasPack = $state(false);
    let busy = $state(false);
    let status = $state("正在准备资源…");

    getSession().then(created => {
        session = created;
        ready = true;
        status = "选一个谱面压缩包";
    }).catch(error => {
        console.error(error);
        status = `初始化失败：${(error as Error).message}`;
    });

    async function pick(event: Event) {
        const input = event.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file || !session || !canvasEl) {
            return;
        }

        busy = true;
        status = "正在解压…";
        try {
            pack = await session.load(canvasEl, file);
            hasPack = true;
            status = "好了，空格播放 / 暂停";
        } catch (error) {
            console.error(error);
            status = `加载失败：${(error as Error).message}`;
        } finally {
            busy = false;
        }
    }
</script>

<section class="bar">
    <input type="file" accept=".zip" onchange={pick} disabled={!ready || busy} />
    <a href="/record">去录制</a>
    <span class="status">{status}</span>
</section>

<canvas id="player-canvas" width="1600" height="900"></canvas>

<script onmount>
    canvasEl = document.getElementById("player-canvas") as HTMLCanvasElement | null;

    window.addEventListener("keydown", event => {
        if (event.key !== " " || !pack) {
            return;
        }
        // 空格别把页面滚下去
        event.preventDefault();
        if (pack.player.playing) {
            pack.player.pause();
        } else {
            pack.player.play();
        }
    });
</script>

<style>
    .bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: 0.5rem 0.75rem;
    }

    .status {
        color: #9aa;
        font-variant-numeric: tabular-nums;
    }
</style>
