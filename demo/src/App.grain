<script>
    import routes from "grain:routes";
    import { createRouter } from "@graints/runtime";
</script>

<main bind:this={outlet}></main>

<script onmount>
    if (outlet) {
        // base 交给 vite：部署在 GitHub Pages 子路径下时 import.meta.env.BASE_URL
        // 就是 `/kipphi-player/`，路由表和地址栏因此能对上
        createRouter({ routes, target: outlet, base: import.meta.env.BASE_URL }).start();
    }
</script>
